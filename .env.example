# Скопируй этот файл в .env и заполни своими значениями с emailjs.com
# (Dashboard -> Email Services / Email Templates / Account -> General)
#
# Пока эти переменные не заполнены, приложение работает в демо-режиме:
# письма не отправляются по-настоящему, только показывается уведомление
# в интерфейсе о том, что письмо "было бы отправлено".

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase (Firestore) — общее хранилище данных, чтобы записи технадзора сразу
# были видны КАЖ на любом другом устройстве/браузере.
# Получить конфиг: console.firebase.google.com -> ваш проект -> ⚙️ Project settings
# -> General -> Your apps -> веб-приложение (иконка </>) -> Config.
#
# Пока эти переменные не заполнены, приложение работает в локальном режиме:
# данные хранятся только в localStorage этого браузера (видно вверху страницы
# предупреждение об этом).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
